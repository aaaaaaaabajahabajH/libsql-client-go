# ══════════════════════════════════════════════════════════════════
# AI Business Assistant — Environment Variables
# Copy this file and fill in real values:
#   Development: cp .env.example .env.local
#   Staging:     cp .env.example .env.staging
#   Production:  set via Vercel / cloud dashboard / Docker secrets
# ══════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
# The public-facing URL of this deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose this in the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ───────────────────────────────────────────────────────
# Use test keys (pk_test_... / sk_test_...) for development/staging
# Use live keys (pk_live_... / sk_live_...) for production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe Dashboard → Products
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...

# ── Resend ───────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Analytics (optional) ─────────────────────────────────────────
# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog — cloud.us by default
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Sentry (optional but recommended in production) ───────────────
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
# Required for source map uploads during CI build:
SENTRY_AUTH_TOKEN=sntrys_...

# ── Cron job protection ───────────────────────────────────────────
# A long random secret — used to authenticate the email queue cron
CRON_SECRET=a-long-random-secret-here

# ── Runtime ──────────────────────────────────────────────────────
NODE_ENV=development
