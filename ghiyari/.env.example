VITE_ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# ── Supabase ──────────────────────────────
# احصل على البيانات من: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# ── Shopify Storefront API ────────────────
# احصل عليه من: Shopify Admin → Apps → Storefront API
VITE_SHOPIFY_STOREFRONT_TOKEN=REPLACE_ME
VITE_SHOPIFY_STORE_DOMAIN=ghiyari.myshopify.com

# ── Mailchimp ─────────────────────────────
# احصل عليه من: https://mailchimp.com/developer
VITE_MAILCHIMP_API_KEY=REPLACE_ME
VITE_MAILCHIMP_LIST_ID=REPLACE_ME
VITE_MAILCHIMP_SERVER_PREFIX=us1

# ── App Config ────────────────────────────
VITE_APP_NAME=غياري
VITE_APP_ENV=development

# ── Google Maps (Google Cloud Console) ───────
