# ─────────────────────────────────────────────────────────────────────────────
# Ghyari Backend · Environment Template
# Copy this to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
GIN_MODE=debug          # release for production

# ── Database ────────────────────────────────────────────────────────────────
# Local SQLite:
DATABASE_URL=file:/tmp/ghyari-dev.db
# Or managed Turso:
# DATABASE_URL=libsql://ghyari-prod.turso.io?authToken=...

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a random secret: openssl rand -hex 32
JWT_SECRET=ghyari-dev-secret-change-me-in-production

# ── AI Radar (optional) ─────────────────────────────────────────────────────
# Claude API key for demand signal analysis
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Observability (optional) ────────────────────────────────────────────────
# Sentry DSN for error tracking
SENTRY_DSN=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
