# ─────────────────────────────────────────────────────────────────────────────
# Ghyari Backend · Environment Template
# Copy to .env for local development. NEVER commit .env.
# For production, use `../scripts/generate-secrets.sh` and load the output
# into your platform's secret manager (Fly secrets, Railway variables, etc.).
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080

# GIN_MODE: 'debug' locally, 'release' in production.
# In 'release' mode the API PANICS on startup if:
#   · JWT_SECRET is unset
#   · JWT_SECRET matches the dev default
#   · JWT_SECRET is shorter than 32 characters
# This is intentional — it prevents accidentally serving with a public secret.
GIN_MODE=debug

# ── Database ────────────────────────────────────────────────────────────────
# Local SQLite (file: prefix required):
DATABASE_URL=file:/tmp/ghyari-dev.db

# Production — managed Turso edge DB:
# DATABASE_URL=libsql://ghyari-prod.turso.io?authToken=eyJhbGci…

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
# Or use the helper: ../scripts/generate-secrets.sh
# The dev value below is REJECTED by the server in GIN_MODE=release.
JWT_SECRET=ghyari-dev-secret-change-in-production-minimum-32-chars

# ── AI Radar (optional) ─────────────────────────────────────────────────────
# Claude API key for demand-signal analysis. Without it, /ai/requests still
# accepts and stores signals, but no automatic analysis runs.
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Observability (optional) ────────────────────────────────────────────────
# Sentry DSN for error tracking
SENTRY_DSN=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, list only your real front-end domains — never '*'.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
