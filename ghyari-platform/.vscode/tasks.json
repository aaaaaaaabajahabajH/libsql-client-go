{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: run",
      "type": "shell",
      "command": "go run .",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "backend: build",
      "type": "shell",
      "command": "go build ./...",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "backend: vet",
      "type": "shell",
      "command": "go vet ./...",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": ["$go"]
    },
    {
      "label": "backend: lint (golangci-lint)",
      "type": "shell",
      "command": "golangci-lint run",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "ai-engine: build",
      "type": "shell",
      "command": "go build ./...",
      "options": { "cwd": "${workspaceFolder}/ai-engine" },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "frontend: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "frontend: lint",
      "type": "shell",
      "command": "npm run lint",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "stack: start backend + frontend",
      "dependsOn": ["backend: run", "frontend: dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
