# ===== Ghyari Platform Environment Variables =====
# Copy this file to .env and fill in your values

# ===== Database (Turso/libsql) =====
TURSO_DATABASE_URL=libsql://ghyari-[your-org].turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ===== Server =====
PORT=8080
GIN_MODE=debug   # debug | release
ENV=development   # development | staging | production
APP_NAME=غياري - Ghyari
APP_URL=https://ghyari.sa

# ===== Authentication =====
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h

# ===== Claude AI (Anthropic) =====
CLAUDE_API_KEY=sk-ant-your-claude-api-key
CLAUDE_MODEL=claude-opus-4-7
AI_RADAR_SCAN_INTERVAL=300   # seconds between demand scans

# ===== Redis Cache =====
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
CACHE_TTL=3600   # seconds

# ===== Storage (Cloudflare R2 / S3) =====
STORAGE_PROVIDER=r2   # r2 | s3 | local
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=ghyari-assets
R2_PUBLIC_URL=https://assets.ghyari.sa

# ===== Payments =====
STCPAY_API_KEY=your-stcpay-key
STCPAY_MERCHANT_ID=your-merchant-id
HYPERPAY_ENTITY_ID=your-hyperpay-entity
HYPERPAY_API_KEY=your-hyperpay-key

# ===== SMS (for OTP) =====
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+966xxxxxxxxx

# ===== Email =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@ghyari.sa
SMTP_PASSWORD=your-smtp-password

# ===== Analytics =====
POSTHOG_API_KEY=your-posthog-key
POSTHOG_HOST=https://app.posthog.com

# ===== CORS =====
ALLOWED_ORIGINS=https://ghyari.sa,https://www.ghyari.sa,http://localhost:3000
