# ══════════════════════════════════════════════════════════════════════════════
# غياري منصة — متغيرات البيئة
# cp .env.example .env   ثم املأ جميع القيم قبل التشغيل
# ══════════════════════════════════════════════════════════════════════════════

# ── قاعدة البيانات (Turso / LibSQL) ──────────────────────────────────────────
# أنشئ قاعدة مجانية: turso db create ghyari-prod
# ثم: turso db show ghyari-prod --url
DATABASE_URL=libsql://ghyari-prod-[org].turso.io

# turso db tokens create ghyari-prod
DATABASE_AUTH_TOKEN=your-turso-auth-token-here

# ── الأمان ───────────────────────────────────────────────────────────────────
# مفتاح JWT عشوائي — لا تستخدم القيمة الافتراضية أبداً في الإنتاج
# توليد: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── ذكاء اصطناعي (Anthropic Claude) ─────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-opus-4-7

# ── السيرفر ──────────────────────────────────────────────────────────────────
PORT=8080
GIN_MODE=release

# النطاقات المسموح بها للـ CORS (مفصولة بفاصلة، بدون مسافات)
ALLOWED_ORIGINS=https://ghyari.sa,https://www.ghyari.sa

# ── Redis ─────────────────────────────────────────────────────────────────────
# يُضبط تلقائياً في Docker Compose — لا تغيّره إلا إذا كنت تشغّل Redis خارجياً
REDIS_URL=redis://redis:6379

# ── عامل الرادار (AI Radar Worker) ───────────────────────────────────────────
# الفاصل بين دورات الفحص بالثواني
SCAN_INTERVAL=300

# ── بوابات الدفع / Payment Gateways ──────────────────────────────────────────

# N-Genius (Network International) — بطاقات + Apple Pay + Google Pay + Samsung Pay
# اطلب بيانات الاعتماد من: https://www.network.global/en/developers
NGENIUS_API_URL=https://api-gateway.network.global
NGENIUS_OUTLET_REF=your-outlet-reference-here
NGENIUS_API_KEY=your-ngenius-api-key-here
NGENIUS_WEBHOOK_SECRET=your-ngenius-webhook-hmac-secret-here

# Tabby BNPL — قسّم دفعتك على 4 أقساط بدون فوائد
# سجّل كتاجر: https://tabby.ai/en-AE/business
TABBY_PUBLIC_KEY=pk_your-tabby-public-key-here
TABBY_SECRET_KEY=sk_your-tabby-secret-key-here
TABBY_MERCHANT_CODE=ghyari

# رابط الواجهة الأمامية — يُستخدم في روابط إعادة التوجيه بعد الدفع
FRONTEND_URL=https://ghyari.sa

# ── Google Cloud Storage ──────────────────────────────────────────────────────
# اسم الـ bucket (يُضبط تلقائياً في Cloud Run — اختياري للـ VPS)
# gcloud storage buckets create gs://ghyari-assets-<project-id>
GCS_BUCKET=ghyari-assets-project-fc665c2c-22d9-477b-8de

# رابط CDN المخصص للأصول (اختياري — إذا كنت تستخدم Cloud CDN أو نطاقاً مخصصاً)
GCS_CDN_BASE=https://assets.ghyari.sa

# مسار ملف Service Account JSON (للتشغيل خارج Google Cloud فقط)
# داخل Cloud Run يُستخدم Default Service Account تلقائياً — اتركه فارغاً
# gcloud iam service-accounts keys create sa-key.json --iam-account=ghyari-api@<project>.iam.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
