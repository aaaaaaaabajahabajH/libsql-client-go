# ══════════════════════════════════════════════════════════════════════════════
# غياري منصة — متغيرات البيئة
# cp .env.example .env   ثم املأ جميع القيم قبل التشغيل
# ══════════════════════════════════════════════════════════════════════════════

# ── قاعدة البيانات (Turso / LibSQL) ──────────────────────────────────────────
# أنشئ قاعدة مجانية: turso db create ghyari-prod
# ثم: turso db show ghyari-prod --url
DATABASE_URL=libsql://ghyari-prod-[org].turso.io

# turso db tokens create ghyari-prod
DATABASE_AUTH_TOKEN=your-turso-auth-token-here

# ── الأمان ───────────────────────────────────────────────────────────────────
# مفتاح JWT عشوائي — لا تستخدم القيمة الافتراضية أبداً في الإنتاج
# توليد: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── ذكاء اصطناعي (Anthropic Claude) ─────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-opus-4-7

# ── السيرفر ──────────────────────────────────────────────────────────────────
PORT=8080
GIN_MODE=release

# النطاقات المسموح بها للـ CORS (مفصولة بفاصلة، بدون مسافات)
ALLOWED_ORIGINS=https://ghyari.sa,https://www.ghyari.sa

# ── Redis ─────────────────────────────────────────────────────────────────────
# يُضبط تلقائياً في Docker Compose — لا تغيّره إلا إذا كنت تشغّل Redis خارجياً
REDIS_URL=redis://redis:6379

# ── عامل الرادار (AI Radar Worker) ───────────────────────────────────────────
# الفاصل بين دورات الفحص بالثواني
SCAN_INTERVAL=300
